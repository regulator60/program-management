# SQLite database file
DATABASE_PATH=data/app.db

# Jira Server / Data Center personal access token (Profile → Personal Access Tokens)
JIRA_PAT=
# ...or basic auth for older Jira without PATs
# JIRA_USER=
# JIRA_PASSWORD=

# Confluence Server PAT (falls back to JIRA_PAT)
CONFLUENCE_PAT=

# Corporate CA bundle if Jira/Confluence use an internal certificate authority
# NODE_EXTRA_CA_CERTS=/path/to/corp-ca.pem
