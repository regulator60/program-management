# SQLite database file
DATABASE_PATH=data/app.db

# Jira Server / Data Center personal access token (Profile → Personal Access Tokens)
JIRA_PAT=
# ...or basic auth for older Jira without PATs
# JIRA_USER=
# JIRA_PASSWORD=

# Confluence Server PAT (falls back to JIRA_PAT)
CONFLUENCE_PAT=

# Optional: read private Google Docs meeting notes via the Drive API.
# A short-lived OAuth token with Drive read scope, e.g.
#   gcloud auth print-access-token --scopes=https://www.googleapis.com/auth/drive.readonly
# Without it, docs must be shared "anyone with the link", or download and attach them.
GOOGLE_ACCESS_TOKEN=

# Corporate CA bundle if Jira/Confluence use an internal certificate authority
# NODE_EXTRA_CA_CERTS=/path/to/corp-ca.pem

# ---- Assistant (preview, OFF by default) ----
# Easiest: turn it on in Settings → Assistant (mode, endpoint, model). Settings win over these;
# the variables below are fallbacks. The API key always lives here, never in the database.
# The chat panel sends your questions and the program data it looks up to an AI endpoint.
# Only turn it on with real data once that endpoint is approved for this data.
#   demo = only while the database holds the fictional demo data (paused once real data is loaded)
#   on   = with real data too
# ASSISTANT_ENABLED=demo
# Where requests go. Leave unset for Anthropic's API, or set your company's approved gateway.
# The SDK sends the key as "Authorization: Bearer <key>".
# ANTHROPIC_BASE_URL=
# ANTHROPIC_API_KEY=
# Optional
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_EFFORT=medium
# ASSISTANT_REFUSAL_FALLBACK=1   # default on for Anthropic's API, off with a custom base URL
