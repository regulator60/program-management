{
  "name": "program-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:demo-site": "next build && node scripts/build-demo-site.mjs",
    "desktop": "node scripts/desktop-runner.mjs run",
    "desktop:install": "node scripts/desktop-runner.mjs install",
    "desktop:uninstall": "node scripts/desktop-runner.mjs uninstall",
    "desktop:status": "node scripts/desktop-runner.mjs status",
    "desktop:stop": "node scripts/desktop-runner.mjs stop"
  },
  "dependencies": {
    "cmdk": "1.1.1",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
